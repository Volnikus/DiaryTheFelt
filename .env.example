DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Spotify song search (developer.spotify.com → Dashboard → Create app)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Felt AI — free providers, tried in order; each has its own quota, so one running out never stops the AI.
# Groq (free key: console.groq.com → API Keys)
GROQ_API_KEY=
# Optional, comma-separated, first is tried first (default: openai/gpt-oss-120b,openai/gpt-oss-20b)
GROQ_MODELS=
# Google Gemini (free key: aistudio.google.com → Get API key)
GEMINI_API_KEY=
# Optional (default: gemini-flash-lite-latest)
GEMINI_MODEL=
# xAI Grok (paid). Used first, but only when FELT_PAID_AI=on; otherwise ignored and the free tier is used.
XAI_API_KEY=
XAI_MODEL=
FELT_PAID_AI=
# Optional extra providers
MISTRAL_API_KEY=
MISTRAL_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# Optional: replace the chat system prompt
FELT_CHAT_SYSTEM_PROMPT=
